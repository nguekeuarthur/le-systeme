	column libelle
		dataType: string
		summarizeBy: none
		sourceColumn: libelle
		sortByColumn: ordre

	column caracteristique
		dataType: string
		summarizeBy: none
		sourceColumn: caracteristique

	column unite
		dataType: string
		summarizeBy: none
		sourceColumn: unite

	column ordre
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
